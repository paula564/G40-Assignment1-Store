@model IEnumerable<psH60A01.Models.Product>

<h1>All Products</h1>

@foreach (var product in Model) {
    <div>
        <p>ID: @product.ProductId</p>
        <p>Category ID: @product.ProdCatId</p>
        <p>Category: @product.ProdCat.ProdCat</p>
        <p>Name: @product.Description</p>
        <p>Stock: @product.Stock</p>
        <p>@Html.ActionLink("Edit Stock", "EditStock", new {productId = product.ProductId})</p>
    </div>
}

