@model psH60A01.Models.Product

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<p>@Html.ActionLink("Go back to Products", "AllProducts")</p>

<div class="grid-card">
    <h3>@Model.Description</h3>
    <p>Category: @Model.ProdCat.ProdCat</p>
    <p>Manufacturer: @Model.Manufacturer</p>
    <p>Stock: @Model.Stock</p>
    <p>Buy price: @Model.BuyPrice</p>
    <p>Sell price: @Model.SellPrice</p>
    @if (Model.Stock <= 0)
    {
        <p class="red-text">OUT OF STOCK</p>
    }

<div>
    <div class="action-buttons">
            <p><a asp-controller="Products" asp-action="Edit" asp-route-id="@Model.ProductId">Edit</a></p>
            
        <p>@Html.ActionLink("Delete", "Delete", new { productId = Model.ProductId })</p>
        <p>@Html.ActionLink("Edit Stock", "EditStock", new {productId = Model.ProductId})</p>
        <p>@Html.ActionLink("Edit Buy Price", "UpdateBuyPrice", new { productId = Model.ProductId })</p>
        <p>@Html.ActionLink("Edit Sell Price", "UpdateSellPrice", new { productId = Model.ProductId })</p>
       </div>
</div>
