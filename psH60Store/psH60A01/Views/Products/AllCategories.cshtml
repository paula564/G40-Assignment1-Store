@model IEnumerable<psH60A01.Models.ProductCategory>

<main class="category-grid-view">
    <a asp-controller="Products" asp-action="CreateCategory">Create a new category</a>
@foreach (var item in Model)
{
    <a asp-controller="Products" asp-action="ProductsByCategory" asp-route-id="@item.CategoryId">
    <div>
        @item.ProdCat
        <a asp-controller="Products" asp-action="EditCategory">Edit</a>
        <a asp-controller="Products" asp-action="DeleteCategory">Delete</a>
    </div>
    </a> 
}
</main>
