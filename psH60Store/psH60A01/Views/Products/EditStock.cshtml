@model psH60A01.Models.Product

<form asp-controller="Products" asp-action="EditStock" method="post">

    <input type="hidden" asp-for="@Model.ProductId" />
 

    <p>Current Stock: @Model.Stock</p>


    <label for="adjustment">Adjustment Amount</label>
    <input type="number" id="adjustment" name="adjustment" />
    <span class="text-danger" id="adjustment-validation"></span>

    <button type="submit">Update Stock</button>
</form>