@model psH60A01.Models.Product

<form asp-controller="Products" asp-action="UpdateBuyPrice" method="post">

    <input type="hidden" asp-for="@Model.ProductId" />
 

    <p>Current Buy Price: @Model.BuyPrice</p>


    <label for="adjustment">New buy price: </label>
    <input type="number" id="newPrice" name="newPrice" />
    <span class="text-danger" id="adjustment-validation"></span>

    <button type="submit">Update Buy Price</button>
</form>