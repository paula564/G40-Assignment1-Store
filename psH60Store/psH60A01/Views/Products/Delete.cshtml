@model psH60A01.Models.Product

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete product</h1>

<h3>Are you sure you want to delete this?</h3>
<div class="grid-card">
    <h3>@Model.Description</h3>
    <p>Category: @Model.ProdCat.ProdCat</p>
    <p>Manufacturer: @Model.Manufacturer</p>
    <p>Stock: @Model.Stock</p>
    <p>Buy price: @Model.BuyPrice</p>
    <p>Sell price: @Model.SellPrice</p>

<div>
        <form asp-action="DeleteConfirmed" asp-route-id="@Model.ProductId">
        <input type="hidden" asp-for="ProductId" />
        <div class="action-buttons">
        <input type="submit" value="Delete" class="btn btn-danger" /> 
        <a asp-action="AllProducts">Back to All Products</a>
         </div>
    </form>
</div>
